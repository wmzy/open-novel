{
  "name": "@wmzy/open-novel",
  "version": "0.1.0",
  "description": "AI 辅助小说写作应用：内置 Pi Agent SDK，BYOK，从立意到成稿的全流程创作。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmzy/open-novel.git"
  },
  "homepage": "https://github.com/wmzy/open-novel#readme",
  "bugs": {
    "url": "https://github.com/wmzy/open-novel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "open-novel": "bin/open-novel.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "plugins/",
    "templates/",
    "drizzle/",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:client && npm run build:server",
    "prepack": "npm run build",
    "start": "node dist/server/api.js",
    "explore": "node scripts/explore.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval:consistency": "node scripts/eval-consistency.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.0.2",
    "@linaria/core": "^7.0.0",
    "@linaria/react": "^7.0.1",
    "@tanstack/react-query": "^5.100.10",
    "@wyw-in-js/shared": "^1.1.0",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "0.8.2",
    "haze-ui": "^1.5.6",
    "hono": "^4.12.18",
    "marked": "18.1.2",
    "mermaid": "^11.16.0",
    "pino": "^10.3.1",
    "pino-pretty": "^10.3.1",
    "pinyin-pro": "^3.28.1",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.15.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
    "turndown": "7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.25.0",
    "@babel/preset-react": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@stylistic/eslint-plugin": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^8.0.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@wyw-in-js/babel-preset": "^1.1.0",
    "@wyw-in-js/vite": "^1.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
